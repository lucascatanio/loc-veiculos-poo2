<UserControl x:Class="Locadora.Desktop.Controles.StatusSelo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz" HorizontalAlignment="Left" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
        <Ellipse Width="8" Height="8" Margin="0,1,7,0" VerticalAlignment="Center"
                 Fill="{Binding Status, ElementName=Raiz, Converter={StaticResource StatusParaBrush}}"/>
        <TextBlock FontFamily="{StaticResource BarlowMedium}" VerticalAlignment="Center"
                   Text="{Binding Status, ElementName=Raiz, Converter={StaticResource StatusParaTexto}}"/>
    </StackPanel>
</UserControl>
