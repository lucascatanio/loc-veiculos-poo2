<UserControl x:Class="Locadora.Desktop.Controles.PlacaMercosul"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Center">
    <Viewbox x:Name="Escala" Stretch="Uniform" Width="120" Height="39">
        <Border Width="240" Height="78" CornerRadius="8" Background="{StaticResource PapelBrush}"
                BorderBrush="{StaticResource AsfaltoBrush}" BorderThickness="3" ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource AzulMercosulBrush}">
                    <Grid>
                        <Grid HorizontalAlignment="Left" Margin="12,0,0,0" Width="16" Height="10" VerticalAlignment="Center">
                            <Rectangle Fill="{StaticResource LiberadoBrush}"/>
                            <Polygon Points="8,1.5 14,5 8,8.5 2,5" Fill="{StaticResource FaixaAmarelaBrush}"/>
                        </Grid>
                        <TextBlock Text="BRASIL" FontFamily="{StaticResource BarlowSemiBold}" FontSize="13"
                                   Foreground="{StaticResource PapelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ItemsControl x:Name="Caracteres" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource BarlowCondensedSemiBold}" FontSize="52"
                                       Foreground="{StaticResource AsfaltoBrush}" Margin="2,-6,2,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Viewbox>
</UserControl>
