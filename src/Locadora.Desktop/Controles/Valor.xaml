<UserControl x:Class="Locadora.Desktop.Controles.Valor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz" HorizontalAlignment="Left" VerticalAlignment="Center">
    <StackPanel>
        <TextBlock Style="{StaticResource TextoMiudo}" Text="{Binding Rotulo, ElementName=Raiz}"
                   Visibility="{Binding Rotulo, ElementName=Raiz, Converter={StaticResource TextoPreenchido}}"/>
        <TextBlock x:Name="Numero" Style="{StaticResource Valor}"
                   Text="{Binding Quantia, ElementName=Raiz, Converter={StaticResource MoedaBr}}"/>
    </StackPanel>
</UserControl>
