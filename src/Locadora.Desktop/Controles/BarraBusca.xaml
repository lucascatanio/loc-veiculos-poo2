<UserControl x:Class="Locadora.Desktop.Controles.BarraBusca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">
    <StackPanel Orientation="Horizontal">
        <Grid Width="280">
            <TextBox x:Name="Caixa" VerticalContentAlignment="Center"
                     Text="{Binding TextoBusca, ElementName=Raiz, UpdateSourceTrigger=PropertyChanged, Delay=300}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ComandoBuscar, ElementName=Raiz}"/>
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="{Binding Dica, ElementName=Raiz}" Foreground="{StaticResource TextoSecundarioBrush}"
                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"
                       Visibility="{Binding Text, ElementName=Caixa, Converter={StaticResource TextoVazio}}"/>
        </Grid>
        <CheckBox Content="Mostrar inativos" VerticalAlignment="Center" Margin="16,0,0,0"
                  IsChecked="{Binding MostrarInativos, ElementName=Raiz}"/>
    </StackPanel>
</UserControl>
