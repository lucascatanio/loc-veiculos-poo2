<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Locadora.Desktop.ViewModels"
                    xmlns:views="clr-namespace:Locadora.Desktop.Views"
                    xmlns:vmLocacoes="clr-namespace:Locadora.Desktop.ViewModels.Locacoes"
                    xmlns:viewsLocacoes="clr-namespace:Locadora.Desktop.Views.Locacoes">

    <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ShellViewModel}"><views:ShellView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PainelViewModel}"><views:PainelView/></DataTemplate>
    <DataTemplate DataType="{x:Type vmLocacoes:LocacoesViewModel}"><viewsLocacoes:LocacoesView/></DataTemplate>
    <DataTemplate DataType="{x:Type vmLocacoes:LocacaoDetalheViewModel}"><viewsLocacoes:LocacaoDetalheView/></DataTemplate>
    <DataTemplate DataType="{x:Type vmLocacoes:NovaLocacaoViewModel}"><viewsLocacoes:NovaLocacaoView/></DataTemplate>
    <DataTemplate DataType="{x:Type vmLocacoes:DevolucaoViewModel}"><viewsLocacoes:DevolucaoView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ClientesViewModel}"><views:ClientesView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:VeiculosViewModel}"><views:VeiculosView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CategoriasViewModel}"><views:CategoriasView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FuncionariosViewModel}"><views:FuncionariosView/></DataTemplate>

</ResourceDictionary>
