<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Locadora.Desktop.Controles"
                    xmlns:vmLocacoes="clr-namespace:Locadora.Desktop.ViewModels.Locacoes">

    <!-- Vocabulário do contrato, compartilhado entre a tela do contrato e o resumo da nova locação -->
    <DataTemplate x:Key="FatoDoContratoModelo">
        <StackPanel Margin="0,0,0,16">
            <TextBlock Style="{StaticResource TextoMiudo}" Text="{Binding Rotulo}"/>
            <TextBlock Style="{StaticResource TextoDestaque}" TextWrapping="Wrap" Text="{Binding Texto}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TotalDoContratoModelo">
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource TextoSecundario}" VerticalAlignment="Center" Text="{Binding Rotulo}"/>
            <c:Valor Grid.Column="1" Quantia="{Binding Valor}"/>
        </Grid>
    </DataTemplate>

    <!-- A caixa de seleção da ComboBox do tema não aplica DisplayMemberPath; estes modelos mostram o nome. -->
    <DataTemplate x:Key="NomeDaOpcao">
        <TextBlock Text="{Binding Nome}"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vmLocacoes:FormaDePagamento}">
        <TextBlock Text="{Binding Nome}"/>
    </DataTemplate>
</ResourceDictionary>
