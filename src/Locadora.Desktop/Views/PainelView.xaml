<UserControl x:Class="Locadora.Desktop.Views.PainelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Locadora.Desktop.Conversores"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:c="clr-namespace:Locadora.Desktop.Controles"
             Style="{StaticResource TelaBase}">
    <UserControl.Resources>
        <conv:TelefoneConversor x:Key="Telefone"/>
        <conv:MinutosParaAtrasoConversor x:Key="MinutosParaAtraso"/>
        <conv:ParticipacaoParaLarguraConversor x:Key="ParticipacaoParaLargura" LarguraTotal="480"/>

        <GridLength x:Key="LarguraMarca">4</GridLength>
        <GridLength x:Key="LarguraPlaca">136</GridLength>
        <GridLength x:Key="LarguraTelefone">144</GridLength>
        <GridLength x:Key="LarguraAtraso">80</GridLength>
        <GridLength x:Key="LarguraMulta">120</GridLength>
        <GridLength x:Key="LarguraHorario">200</GridLength>
        <system:Double x:Key="AlturaMaximaDaLista">224</system:Double>

        <Style x:Key="LinhaDaLista" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource DivisoriaBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource PapelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextoDaLinha" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="AvisoDeSecaoVazia" TargetType="TextBlock" BasedOn="{StaticResource TextoSecundario}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <DataTemplate x:Key="LinhaAtrasada">
            <Button Style="{StaticResource LinhaDaLista}"
                    Command="{Binding DataContext.AbrirLocacaoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding LocacaoId}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LarguraMarca}"/>
                        <ColumnDefinition Width="{StaticResource LarguraPlaca}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource LarguraTelefone}"/>
                        <ColumnDefinition Width="{StaticResource LarguraAtraso}"/>
                        <ColumnDefinition Width="{StaticResource LarguraMulta}"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource SinalVermelhoBrush}"/>
                    <c:PlacaMercosul Grid.Column="1" Margin="16,0,0,0" Placa="{Binding VeiculoPlaca}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource TextoDaLinha}" Margin="24,0,16,0"
                               Text="{Binding ClienteNome}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource TextoDaLinha}"
                               Text="{Binding ClienteTelefone, Converter={StaticResource Telefone}}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource TextoDaLinha}"
                               FontFamily="{StaticResource BarlowMedium}"
                               Foreground="{StaticResource SinalVermelhoBrush}"
                               Text="{Binding MinutosAtraso, Converter={StaticResource MinutosParaAtraso}}"/>
                    <c:Valor Grid.Column="5" Tom="Erro" Margin="0,0,16,0"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             Quantia="{Binding MultaEstimada}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="LinhaVencendoHoje">
            <Button Style="{StaticResource LinhaDaLista}"
                    Command="{Binding DataContext.AbrirLocacaoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding LocacaoId}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource LarguraMarca}"/>
                        <ColumnDefinition Width="{StaticResource LarguraPlaca}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource LarguraTelefone}"/>
                        <ColumnDefinition Width="{StaticResource LarguraHorario}"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource FaixaAmarelaBrush}"/>
                    <c:PlacaMercosul Grid.Column="1" Margin="16,0,0,0" Placa="{Binding VeiculoPlaca}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource TextoDaLinha}" Margin="24,0,16,0"
                               Text="{Binding ClienteNome}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource TextoDaLinha}"
                               Text="{Binding ClienteTelefone, Converter={StaticResource Telefone}}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource TextoDaLinha}"
                               FontFamily="{StaticResource BarlowMedium}"
                               Foreground="{StaticResource AtencaoTextoBrush}"
                               Text="{Binding DataPrevistaDevolucao, StringFormat=HH:mm}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ContadorDeStatus">
            <StackPanel Margin="0,0,40,0">
                <TextBlock Style="{StaticResource NumeroGrande}" FontSize="48" Text="{Binding Quantidade}"/>
                <c:StatusSelo Status="{Binding Status}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TrechoDaBarraDeFrota">
            <Rectangle Height="6"
                       Width="{Binding ParticipacaoNaFrota, Converter={StaticResource ParticipacaoParaLargura}}"
                       Fill="{Binding Status, Converter={StaticResource StatusParaBrush}}"/>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="PainelHorizontal">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" Width="896" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TextoTitulo}" VerticalAlignment="Center" Text="{Binding Titulo}"/>
                <Button Style="{StaticResource Primario}" Margin="32,0,0,0"
                        Content="Registrar retirada"
                        Command="{Binding RegistrarRetiradaCommand}"/>
                <Button Style="{StaticResource Link}" Margin="16,0,0,0" VerticalAlignment="Center"
                        Content="Atualizar"
                        Command="{Binding CarregarPainelCommand}"/>
            </StackPanel>

            <c:MensagemErro Margin="0,16,0,0" Mensagem="{Binding MensagemErro}"/>

            <TextBlock Style="{StaticResource TextoSecundario}" Margin="0,24,0,0" Text="Carregando o painel"
                       Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}"/>

            <StackPanel Visibility="{Binding Carregado, Converter={StaticResource BoolParaVisibilidade}}">
                <TextBlock Style="{StaticResource TextoSubtitulo}" Margin="0,24,0,8" Text="Atrasadas"/>
                <TextBlock Style="{StaticResource AvisoDeSecaoVazia}" Text="Nenhuma locação atrasada."
                           Visibility="{Binding SemAtrasadas, Converter={StaticResource BoolParaVisibilidade}}"/>
                <ScrollViewer MaxHeight="{StaticResource AlturaMaximaDaLista}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Atrasadas}"
                                  ItemTemplate="{StaticResource LinhaAtrasada}"
                                  IsTabStop="False"/>
                </ScrollViewer>

                <TextBlock Style="{StaticResource TextoSubtitulo}" Margin="0,32,0,8" Text="Vencem hoje"/>
                <TextBlock Style="{StaticResource AvisoDeSecaoVazia}" Text="Nenhuma devolução prevista para hoje."
                           Visibility="{Binding SemVencimentosHoje, Converter={StaticResource BoolParaVisibilidade}}"/>
                <ScrollViewer MaxHeight="{StaticResource AlturaMaximaDaLista}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VencendoHoje}"
                                  ItemTemplate="{StaticResource LinhaVencendoHoje}"
                                  IsTabStop="False"/>
                </ScrollViewer>

                <TextBlock Style="{StaticResource TextoSubtitulo}" Margin="0,32,0,16" Text="Frota"/>
                <ItemsControl ItemsSource="{Binding Frota}"
                              ItemTemplate="{StaticResource ContadorDeStatus}"
                              ItemsPanel="{StaticResource PainelHorizontal}"
                              IsTabStop="False"/>
                <ItemsControl Margin="0,8,0,0" HorizontalAlignment="Left"
                              ItemsSource="{Binding Frota}"
                              ItemTemplate="{StaticResource TrechoDaBarraDeFrota}"
                              ItemsPanel="{StaticResource PainelHorizontal}"
                              IsTabStop="False"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
