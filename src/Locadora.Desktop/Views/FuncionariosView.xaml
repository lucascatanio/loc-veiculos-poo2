<UserControl x:Class="Locadora.Desktop.Views.FuncionariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Locadora.Desktop.Controles"
             xmlns:comportamentos="clr-namespace:Locadora.Desktop.Comportamentos"
             Style="{StaticResource TelaBase}">
    <UserControl.Resources>
        <Style x:Key="NomeDaLinha" TargetType="TextBlock" BasedOn="{StaticResource TextoDestaque}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ativo}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmailDaLinha" TargetType="TextBlock" BasedOn="{StaticResource TextoMiudo}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="InativarFuncionario" TargetType="Button" BasedOn="{StaticResource LinkPerigoso}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding EditandoOProprioUsuario}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                   Style="{StaticResource TextoTitulo}"
                   Text="{Binding Titulo}"/>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:BarraBusca TextoBusca="{Binding TextoBusca, Mode=TwoWay}"
                          MostrarInativos="{Binding MostrarInativos, Mode=TwoWay}"
                          ComandoBuscar="{Binding CarregarCommand}"
                          Margin="0,0,0,16"/>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Itens}"
                      SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                      Visibility="{Binding ListaVazia, Converter={StaticResource BoolParaVisibilidadeInvertida}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource NomeDaLinha}" Text="{Binding Nome}"/>
                                    <TextBlock Style="{StaticResource TextoMiudo}"
                                               Text="você"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding EhUsuarioLogado, Converter={StaticResource BoolParaVisibilidade}}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource EmailDaLinha}" Text="{Binding Email}"/>
                            </StackPanel>
                            <c:StatusSelo Grid.Column="1"
                                          Status="Inativo"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Ativo, Converter={StaticResource BoolParaVisibilidadeInvertida}}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <c:EstadoVazio Grid.Row="1"
                           VerticalAlignment="Top"
                           Texto="Nenhum funcionário encontrado."
                           TextoAcao="Novo funcionário"
                           Comando="{Binding NovoCommand}"
                           Visibility="{Binding ListaVazia, Converter={StaticResource BoolParaVisibilidade}}"/>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1"
                Margin="32,24,0,0"
                Padding="32,0,0,0"
                BorderBrush="{StaticResource DivisoriaBrush}"
                BorderThickness="1,0,0,0">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource TextoSubtitulo}"
                           Text="Novo funcionário"
                           Visibility="{Binding Editando, Converter={StaticResource BoolParaVisibilidadeInvertida}}"/>
                <TextBlock Style="{StaticResource TextoSubtitulo}"
                           Text="Editar funcionário"
                           Visibility="{Binding Editando, Converter={StaticResource BoolParaVisibilidade}}"/>

                <c:CampoFormulario Rotulo="Nome" Margin="0,16,0,0">
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
                </c:CampoFormulario>

                <c:CampoFormulario Rotulo="E-mail" Margin="0,16,0,0">
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
                </c:CampoFormulario>

                <c:CampoFormulario Rotulo="Senha"
                                   Ajuda="Mínimo de 6 caracteres."
                                   Margin="0,16,0,0"
                                   Visibility="{Binding Editando, Converter={StaticResource BoolParaVisibilidadeInvertida}}">
                    <PasswordBox MaxLength="72"
                                 comportamentos:SenhaVinculada.Senha="{Binding Senha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </c:CampoFormulario>

                <c:MensagemErro Mensagem="{Binding MensagemErro}" Margin="0,16,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Style="{StaticResource Primario}"
                            Content="Salvar funcionário"
                            Command="{Binding SalvarCommand}"/>
                    <Button Content="Novo funcionário"
                            Command="{Binding NovoCommand}"
                            Margin="12,0,0,0"/>
                    <Button Style="{StaticResource InativarFuncionario}"
                            Content="Inativar funcionário"
                            Command="{Binding InativarCommand}"
                            Margin="16,0,0,0"
                            Visibility="{Binding PodeInativar, Converter={StaticResource BoolParaVisibilidade}}"/>
                    <Button Style="{StaticResource Link}"
                            Content="Reativar funcionário"
                            Command="{Binding ReativarCommand}"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding PodeReativar, Converter={StaticResource BoolParaVisibilidade}}"/>
                </StackPanel>

                <TextBlock Style="{StaticResource TextoMiudo}"
                           Text="Você não pode inativar o seu próprio usuário."
                           Margin="0,8,0,0"
                           Visibility="{Binding EditandoOProprioUsuario, Converter={StaticResource BoolParaVisibilidade}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
