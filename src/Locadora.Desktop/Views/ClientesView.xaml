<UserControl x:Class="Locadora.Desktop.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Locadora.Desktop.Controles"
             xmlns:conv="clr-namespace:Locadora.Desktop.Conversores"
             xmlns:comp="clr-namespace:Locadora.Desktop.Comportamentos"
             Style="{StaticResource TelaBase}">
    <UserControl.Resources>
        <conv:CpfConversor x:Key="Cpf"/>
        <conv:TelefoneConversor x:Key="Telefone"/>

        <Style x:Key="NomeDaLinha" TargetType="TextBlock" BasedOn="{StaticResource TextoDestaque}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ativo}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                   Style="{StaticResource TextoTitulo}"
                   Text="{Binding Titulo}"/>

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <c:BarraBusca Dica="Buscar por nome ou CPF"
                          TextoBusca="{Binding TextoBusca, Mode=TwoWay}"
                          MostrarInativos="{Binding MostrarInativos, Mode=TwoWay}"
                          ComandoBuscar="{Binding CarregarCommand}"
                          Margin="0,0,0,16"/>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Itens}"
                      SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                      Visibility="{Binding ListaVazia, Converter={StaticResource BoolParaVisibilidadeInvertida}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="116"/>
                                <ColumnDefinition Width="128"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource NomeDaLinha}" Text="{Binding Nome}"/>
                            <c:StatusSelo Grid.Column="1"
                                          Status="Inativo"
                                          Margin="12,0"
                                          Visibility="{Binding Ativo, Converter={StaticResource BoolParaVisibilidadeInvertida}}"/>
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource TextoSecundario}"
                                       Text="{Binding Cpf, Converter={StaticResource Cpf}}"/>
                            <TextBlock Grid.Column="3"
                                       Style="{StaticResource TextoSecundario}"
                                       Text="{Binding Telefone, Converter={StaticResource Telefone}}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <c:EstadoVazio Grid.Row="1"
                           VerticalAlignment="Top"
                           Texto="Nenhum cliente encontrado."
                           Visibility="{Binding ListaVazia, Converter={StaticResource BoolParaVisibilidade}}"/>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1"
                Margin="32,24,0,0"
                Padding="32,0,0,0"
                BorderBrush="{StaticResource DivisoriaBrush}"
                BorderThickness="1,0,0,0">
            <StackPanel MaxWidth="400" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource TextoSubtitulo}"
                           Text="Novo cliente"
                           Visibility="{Binding Editando, Converter={StaticResource BoolParaVisibilidadeInvertida}}"/>
                <TextBlock Style="{StaticResource TextoSubtitulo}"
                           Text="Editar cliente"
                           Visibility="{Binding Editando, Converter={StaticResource BoolParaVisibilidade}}"/>

                <c:CampoFormulario Rotulo="Nome" Margin="0,16,0,0">
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
                </c:CampoFormulario>

                <c:CampoFormulario Rotulo="CPF"
                                   Ajuda="11 dígitos, só números."
                                   Margin="0,16,0,0"
                                   Visibility="{Binding Editando, Converter={StaticResource BoolParaVisibilidadeInvertida}}">
                    <TextBox Text="{Binding Cpf, UpdateSourceTrigger=PropertyChanged}" MaxLength="11"
                             comp:EntradaRestrita.Modo="Digitos"/>
                </c:CampoFormulario>
                <c:CampoFormulario Rotulo="CPF"
                                   Ajuda="O CPF não pode ser alterado."
                                   Margin="0,16,0,0"
                                   Visibility="{Binding Editando, Converter={StaticResource BoolParaVisibilidade}}">
                    <TextBox Text="{Binding Cpf, Mode=OneWay, Converter={StaticResource Cpf}}"
                             IsReadOnly="True"/>
                </c:CampoFormulario>

                <c:CampoFormulario Rotulo="CNH"
                                   Ajuda="11 dígitos, só números."
                                   Margin="0,16,0,0">
                    <TextBox Text="{Binding Cnh, UpdateSourceTrigger=PropertyChanged}" MaxLength="11"
                             comp:EntradaRestrita.Modo="Digitos"/>
                </c:CampoFormulario>

                <c:CampoFormulario Rotulo="Telefone"
                                   Ajuda="DDD + número, só números, como 11987654321."
                                   Margin="0,16,0,0">
                    <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" MaxLength="11"
                             comp:EntradaRestrita.Modo="Digitos"/>
                </c:CampoFormulario>

                <c:CampoFormulario Rotulo="E-mail (opcional)" Margin="0,16,0,0">
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
                </c:CampoFormulario>

                <c:MensagemErro Mensagem="{Binding MensagemErro}" Margin="0,16,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Style="{StaticResource Primario}"
                            Content="Salvar cliente"
                            Command="{Binding SalvarCommand}"/>
                    <Button Content="Limpar formulário"
                            Command="{Binding LimparFormularioCommand}"
                            Margin="12,0,0,0"/>
                    <Button Style="{StaticResource LinkPerigoso}"
                            Content="Inativar cliente"
                            Command="{Binding InativarCommand}"
                            Margin="16,0,0,0"
                            Visibility="{Binding PodeInativar, Converter={StaticResource BoolParaVisibilidade}}"/>
                    <Button Style="{StaticResource Link}"
                            Content="Reativar cliente"
                            Command="{Binding ReativarCommand}"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding PodeReativar, Converter={StaticResource BoolParaVisibilidade}}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
