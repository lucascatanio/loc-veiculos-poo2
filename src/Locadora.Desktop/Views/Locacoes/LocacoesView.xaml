<UserControl x:Class="Locadora.Desktop.Views.Locacoes.LocacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Locadora.Desktop.Controles"
             xmlns:vm="clr-namespace:Locadora.Desktop.ViewModels.Locacoes"
             Style="{StaticResource TelaBase}"
             Loaded="AoCarregar">

    <UserControl.Resources>
        <GridLength x:Key="LarguraPlaca">136</GridLength>
        <GridLength x:Key="LarguraData">104</GridLength>
        <GridLength x:Key="LarguraValor">120</GridLength>

        <Style x:Key="Segmento" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource BarlowMedium}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Borda" Padding="0,6" Margin="0,0,24,0" BorderThickness="0,0,0,3"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AsfaltoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AzulMercosulBrush}"/>
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource AzulMercosulBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CabecalhoDeColuna" TargetType="TextBlock" BasedOn="{StaticResource TextoMiudo}"/>

        <Style x:Key="DataPrevista" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Situacao}" Value="Hoje">
                    <Setter Property="Foreground" Value="{StaticResource AtencaoTextoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Situacao}" Value="Atrasada">
                    <Setter Property="Foreground" Value="{StaticResource SinalVermelhoBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="LinhaDeLocacao" DataType="{x:Type vm:LocacaoLinha}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource LarguraPlaca}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource LarguraData}"/>
                    <ColumnDefinition Width="{StaticResource LarguraData}"/>
                    <ColumnDefinition Width="{StaticResource LarguraValor}"/>
                    <ColumnDefinition Width="{StaticResource LarguraValor}"/>
                </Grid.ColumnDefinitions>
                <c:PlacaMercosul Grid.Column="0" Placa="{Binding VeiculoPlaca}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource TextoDestaque}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" Text="{Binding ClienteNome}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Text="{Binding DataRetirada, StringFormat={}{0:dd/MM HH:mm}}"/>
                <TextBlock Grid.Column="3" Style="{StaticResource DataPrevista}"
                           Text="{Binding DataPrevistaDevolucao, StringFormat={}{0:dd/MM HH:mm}}"/>
                <c:Valor Grid.Column="4" Quantia="{Binding ValorTotal}"/>
                <c:Valor Grid.Column="5" Quantia="{Binding SaldoDevedor}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Style="{StaticResource TextoTitulo}" Text="{Binding Titulo}"/>
            <Button Style="{StaticResource Primario}" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="Registrar retirada" Command="{Binding NovaLocacaoCommand}"/>
        </Grid>

        <ListBox Grid.Row="1" Margin="0,16,0,0" ItemsSource="{Binding Opcoes}" SelectedItem="{Binding StatusSelecionado}"
                 DisplayMemberPath="Titulo" ItemContainerStyle="{StaticResource Segmento}"
                 Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <c:MensagemErro Grid.Row="2" Margin="0,12,0,0" Mensagem="{Binding MensagemErro}"/>

        <Grid Grid.Row="3" Margin="13,16,30,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource LarguraPlaca}"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{StaticResource LarguraData}"/>
                <ColumnDefinition Width="{StaticResource LarguraData}"/>
                <ColumnDefinition Width="{StaticResource LarguraValor}"/>
                <ColumnDefinition Width="{StaticResource LarguraValor}"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource CabecalhoDeColuna}" Text="Veículo"/>
            <TextBlock Grid.Column="1" Style="{StaticResource CabecalhoDeColuna}" Text="Cliente"/>
            <TextBlock Grid.Column="2" Style="{StaticResource CabecalhoDeColuna}" Text="Retirada"/>
            <TextBlock Grid.Column="3" Style="{StaticResource CabecalhoDeColuna}" Text="Prevista"/>
            <TextBlock Grid.Column="4" Style="{StaticResource CabecalhoDeColuna}" Text="Total"/>
            <TextBlock Grid.Column="5" Style="{StaticResource CabecalhoDeColuna}" Text="Saldo"/>
        </Grid>

        <Grid Grid.Row="4">
            <ListView ScrollViewer.VerticalScrollBarVisibility="Visible" ItemsSource="{Binding Locacoes}" SelectedItem="{Binding LocacaoSelecionada}"
                      ItemTemplate="{StaticResource LinhaDeLocacao}"
                      Visibility="{Binding ListaVazia, Converter={StaticResource BoolParaVisibilidadeInvertida}}"/>
            <c:EstadoVazio Texto="{Binding StatusSelecionado.TextoVazio}" TextoAcao="Registrar retirada"
                           Comando="{Binding NovaLocacaoCommand}"
                           Visibility="{Binding ListaVazia, Converter={StaticResource BoolParaVisibilidade}}"/>
        </Grid>
    </Grid>
</UserControl>
