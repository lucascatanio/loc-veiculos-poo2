<Window x:Class="Locadora.Desktop.Views.JanelaDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource JanelaBase}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="440" WindowStartupLocation="CenterOwner"
        BorderBrush="{StaticResource AsfaltoBrush}" BorderThickness="1">
    <Border Background="{StaticResource PapelBrush}" Padding="24" MouseLeftButtonDown="Arrastar">
        <StackPanel>
            <TextBlock x:Name="Titulo" Style="{StaticResource TextoSubtitulo}" TextWrapping="Wrap"/>
            <TextBlock x:Name="Mensagem" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="Cancelar" IsCancel="True" Margin="0,0,8,0" MinWidth="88" Click="Cancelar_Click"/>
                <Button x:Name="Confirmar" Style="{StaticResource Primario}" IsDefault="True" MinWidth="88" Click="Confirmar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
