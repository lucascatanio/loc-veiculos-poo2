<UserControl x:Class="Locadora.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:Locadora.Desktop.Comportamentos"
             Style="{StaticResource TelaBase}" Loaded="AoCarregar">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource AsfaltoBrush}">
            <Grid Margin="64,0,48,56">
                <StackPanel VerticalAlignment="Center">
                    <Rectangle Width="56" Height="6" HorizontalAlignment="Left" Fill="{StaticResource FaixaAmarelaBrush}"/>
                    <TextBlock Style="{StaticResource TextoTitulo}" FontSize="52" Margin="0,20,0,0"
                               Foreground="{StaticResource PapelBrush}" Text="Locadora"/>
                    <TextBlock Style="{StaticResource TextoSubtitulo}" FontFamily="{StaticResource Barlow}" Margin="0,8,0,0"
                               Foreground="{StaticResource DesabilitadoBrush}" Text="Balcão de retirada e devolução"/>
                </StackPanel>
                <TextBlock Style="{StaticResource TextoMiudo}" VerticalAlignment="Bottom"
                           Foreground="{StaticResource DesabilitadoBrush}" Text="Acesso restrito aos funcionários"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <StackPanel Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource TextoTitulo}" Text="Entrar"/>

                <Border Margin="0,16,0,0" Padding="12,8" Background="{StaticResource PapelBrush}"
                        BorderBrush="{StaticResource FaixaAmarelaBrush}" BorderThickness="4,0,0,0"
                        Visibility="{Binding Aviso, Converter={StaticResource TextoParaVisibilidade}}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding Aviso}"/>
                </Border>

                <TextBlock Style="{StaticResource TextoSecundario}" Margin="0,24,0,4" Text="E-mail"/>
                <TextBox x:Name="CampoEmail" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Style="{StaticResource TextoSecundario}" Margin="0,16,0,4" Text="Senha"/>
                <PasswordBox comp:SenhaVinculada.Senha="{Binding Senha, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource SinalVermelhoBrush}"
                           Text="{Binding MensagemErro}"
                           Visibility="{Binding MensagemErro, Converter={StaticResource TextoParaVisibilidade}}"/>

                <Button Style="{StaticResource Primario}" Margin="0,24,0,0" IsDefault="True"
                        Content="Entrar" Command="{Binding EntrarCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
